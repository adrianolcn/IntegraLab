  "journey": {
    "title": "Jornada de Aprendizado em Requestia",
    "subtitle": "Avance por trilhas progressivas e aprenda como APIs e integrações modernas funcionam por dentro, dos fundamentos de rede aos fluxos assíncronos e sistemas distribuídos.",
    "modules": {
      "1": {
        "title": "Módulo 1 — Fundamentos da Internet",
        "topics": ["Cliente e servidor", "IP", "Portas", "TCP/IP", "DNS", "Domínio", "URL", "Diferença entre internet, web e API"]
      },
      "2": {
        "title": "Módulo 2 — HTTP por dentro",
        "topics": ["Requisição", "Resposta", "Métodos HTTP", "Headers", "Body", "Query params", "Path params", "Cookies", "Status codes", "Idempotência"]
      },
      "3": {
        "title": "Módulo 3 — HTTPS, TLS e segurança básica",
        "topics": ["Diferença entre HTTP e HTTPS", "TLS", "Certificados", "Criptografia em trânsito", "Riscos de tráfego sem HTTPS", "Boas práticas de segurança em APIs"]
      },
      "4": {
        "title": "Módulo 4 — REST na prática",
        "topics": ["Recursos", "Endpoints", "Boas práticas REST", "Paginação", "Filtros", "Ordenação", "Versionamento", "Erros de negócio"]
      },
      "5": {
        "title": "Módulo 5 — Autenticação e autorização",
        "topics": ["API Key", "Basic Auth", "Bearer Token", "JWT", "Refresh token", "Roles", "Permissions", "Diferença entre 401 e 403"]
      },
      "6": {
        "title": "Módulo 6 — CORS, navegador e segurança frontend",
        "topics": ["Same-Origin Policy", "CORS", "Preflight", "Headers de segurança", "Por que uma API funciona no Postman e falha no navegador"]
      },
      "7": {
        "title": "Módulo 7 — Contratos de API",
        "topics": ["JSON Schema", "OpenAPI", "Swagger", "Validação de payload", "Documentação viva", "Versionamento de contrato"]
      },
      "8": {
        "title": "Módulo 8 — Debug, erros e observabilidade",
        "topics": ["Logs", "Correlation ID", "Traces", "Métricas", "Timeout", "Retry", "Rate limit", "Erros 400, 401, 403, 404, 409, 422 e 500"]
      },
      "9": {
        "title": "Módulo 9 — Webhooks",
        "topics": ["Eventos externos", "Assinatura", "Retry", "Idempotência", "Duplicidade", "Pagamentos", "Confirmação assíncrona"]
      },
      "10": {
        "title": "Módulo 10 — GraphQL",
        "topics": ["Schema", "Query", "Mutation", "Resolver", "Overfetching", "Underfetching", "N+1", "Subscriptions"]
      },
      "11": {
        "title": "Módulo 11 — Tempo real",
        "topics": ["Polling", "Server-Sent Events", "WebSocket", "Reconexão", "Broadcasting", "Notificações", "Chat"]
      },
      "12": {
        "title": "Módulo 12 — Event-driven APIs",
        "topics": ["Producer", "Consumer", "Filas", "Tópicos", "Eventos", "DLQ", "Reprocessamento", "Consistência eventual"]
      },
      "13": {
        "title": "Módulo 13 — gRPC e contratos fortes",
        "topics": ["Protocol Buffers", ".proto", "Service", "Message", "Unary call", "Streaming", "Geração de cliente"]
      },
