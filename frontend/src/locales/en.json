  "landing": {
    "hero": {
      "title": "Learn APIs by visualizing the path of every request.",
      "subtitle": "Enter Requestia, solve real missions, follow integration flows step by step, and master modern APIs through a futuristic lab experience.",
      "exploreRequestia": "Explore Requestia",
      "viewJourney": "View Journey"
    },
    "features": {
      "1": {
        "title": "What is IntegraLab?",
        "desc": "An educational platform where you learn distributed systems hands-on. Not just loose endpoints, but complete, interconnected asynchronous flows."
      },
      "2": {
        "title": "What is Requestia?",
        "desc": "An internal gamified universe. An immersive visual representation of the internet where every request is live data navigating real network infrastructure."
      },
      "3": {
        "title": "Future Tracks",
        "desc": "Explore advanced HTTP, dive into integrations via GraphQL, Webhooks, WebSocket, SSE, Event-driven APIs, and rigid contracts with gRPC."
      }
    }
  },
  "journey": {
    "title": "Learning Journey in Requestia",
    "subtitle": "Advance through progressive tracks and learn how modern APIs and integrations work inside, from networking fundamentals to asynchronous flows and distributed systems.",
    "modules": {
      "1": {
        "title": "Module 1 — Internet Fundamentals",
        "topics": ["Client and server", "IP", "Ports", "TCP/IP", "DNS", "Domain", "URL", "Difference between internet, web, and API"]
      },
      "2": {
        "title": "Module 2 — Inside HTTP",
        "topics": ["Request", "Response", "HTTP methods", "Headers", "Body", "Query params", "Path params", "Cookies", "Status codes", "Idempotency"]
      },
      "3": {
        "title": "Module 3 — HTTPS, TLS and basic security",
        "topics": ["Difference between HTTP and HTTPS", "TLS", "Certificates", "Encryption in transit", "Risks of traffic without HTTPS", "API security best practices"]
      },
      "4": {
        "title": "Module 4 — REST in practice",
        "topics": ["Resources", "Endpoints", "REST best practices", "Pagination", "Filters", "Sorting", "Versioning", "Business errors"]
      },
      "5": {
        "title": "Module 5 — Authentication and authorization",
        "topics": ["API Key", "Basic Auth", "Bearer Token", "JWT", "Refresh token", "Roles", "Permissions", "Difference between 401 and 403"]
      },
      "6": {
        "title": "Module 6 — CORS, browser and frontend security",
        "topics": ["Same-Origin Policy", "CORS", "Preflight", "Security headers", "Why an API works in Postman but fails in the browser"]
      },
      "7": {
        "title": "Module 7 — API contracts",
        "topics": ["JSON Schema", "OpenAPI", "Swagger", "Payload validation", "Living documentation", "Contract versioning"]
      },
      "8": {
        "title": "Module 8 — Debugging, errors and observability",
        "topics": ["Logs", "Correlation ID", "Traces", "Metrics", "Timeout", "Retry", "Rate limit", "Errors 400, 401, 403, 404, 409, 422 and 500"]
      },
      "9": {
        "title": "Module 9 — Webhooks",
        "topics": ["External events", "Signature", "Retry", "Idempotency", "Duplication", "Payments", "Asynchronous confirmation"]
      },
      "10": {
        "title": "Module 10 — GraphQL",
        "topics": ["Schema", "Query", "Mutation", "Resolver", "Overfetching", "Underfetching", "N+1", "Subscriptions"]
      },
      "11": {
        "title": "Module 11 — Real-time",
        "topics": ["Polling", "Server-Sent Events", "WebSocket", "Reconnection", "Broadcasting", "Notifications", "Chat"]
      },
      "12": {
        "title": "Module 12 — Event-driven APIs",
        "topics": ["Producer", "Consumer", "Queues", "Topics", "Events", "DLQ", "Reprocessing", "Eventual consistency"]
      },
      "13": {
        "title": "Module 13 — gRPC and strong contracts",
        "topics": ["Protocol Buffers", ".proto", "Service", "Message", "Unary call", "Streaming", "Client generation"]
      },
      "14": {
        "title": "Module 14 — Real-world integrations",
        "topics": ["Payment", "Order", "Inventory", "Tax issuance", "Notification", "Gateway", "External API unavailable", "Compensation", "Partial failures"]
      }
    }
  },
